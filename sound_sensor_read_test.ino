// ============================================================
// כיול חיישן קול (HW-484) - VU מטר, אורט בראודה
// ============================================================
// מטרה: לראות איזה טווח ערכים מגיע מה-AO (יציאה אנלוגית) של
// חיישן הקול, כדי שנדע איך למפות אותו ל-6 נורות ה-LED בהמשך.
//
// לא מחברים שום נורה בשלב הזה - רק את החיישן.
// ============================================================

#define SOUND_AO A0

void setup() {
  Serial.begin(9600);
  Serial.println("=== כיול חיישן קול ===");
  Serial.println("תעשה רעש בעוצמות שונות ותצפה בערכים.");
}

void loop() {
  int level = analogRead(SOUND_AO); // ערך בין 0 ל-1023
  Serial.println(level);
  delay(100); // כדי לא להציף את המסך, 10 קריאות בשנייה
}
