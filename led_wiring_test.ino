// ============================================================
// בדיקת חיווט נורות - VU מטר
// ============================================================
// מדליק כל נורה בנפרד, 1.5 שניות, בלי שום קשר לחיישן הקול.
// מטרה: לוודא שכל 6 הנורות + החיווט שלהן תקינים.
// ============================================================

int ledPins[6] = {2, 3, 4, 5, 6, 7};
const char* names[6] = {"ירוק 1 (D2)", "ירוק 2 (D3)", "צהוב 1 (D4)",
                         "צהוב 2 (D5)", "אדום 1 (D6)", "אדום 2 (D7)"};

void setup() {
  Serial.begin(9600);
  for (int i = 0; i < 6; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }
  Serial.println("=== בדיקת חיווט נורות ===");
}

void loop() {
  for (int i = 0; i < 6; i++) {
    for (int j = 0; j < 6; j++) digitalWrite(ledPins[j], LOW); // כיבוי הכל
    digitalWrite(ledPins[i], HIGH);
    Serial.print("עכשיו דולקת: ");
    Serial.println(names[i]);
    delay(1500);
  }
}
